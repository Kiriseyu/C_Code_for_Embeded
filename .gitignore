# ==========================================================
# C 语言学习仓库 .gitignore
# 适配: Windows (CLion/MinGW) + Linux (Ubuntu, gcc/make)
# ==========================================================

# ---- 编译产物 / 可执行文件 ----
# Windows
*.exe
*.obj
*.lib
*.pdb
*.ilk
*.exp
*.idb

# Linux / 通用
*.out
*.o
*.a
*.so
*.so.*
*.run

# 注意: 不忽略手写的 src/stack/makefile (它是源码构建脚本)
# CMake 生成的 Makefile 位于构建目录内, 已被下面的构建目录规则覆盖

# ---- CMake 构建产物 ----
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/

# ---- 构建目录 ----
# 通用构建目录
build/
build-*/
# CLion 默认构建目录
cmake-build-debug/
cmake-build-release/
cmake-build-*/
# 历史用过的自定义构建目录 (避免再次误提交)
build_test/
build_verify/

# ---- IDE / 编辑器配置 ----
# CLion
.idea/
# VS Code
.vscode/
# 其他
*.iml
*.swp
*.swo
*~

# ---- 操作系统生成文件 ----
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# macOS
.DS_Store
# Linux
*.tmp
*.bak
*.backup
core
core.*

# ---- 临时 / 备份文件 ----
*.z~
*.orig
*.rej
